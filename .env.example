# Copy to .env and fill in real values
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password-url-encoded>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
JWT_SECRET=<random-64-hex>
PORT=4000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<gmail-address>
SMTP_PASS=<gmail-app-password>
MAIL_FROM="Westin College <gmail-address>"
OTP_LOG_TO_CONSOLE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://westin-student.vercel.app,https://westin-faculty.vercel.app

# OneSignal Web Push — faculty/admin portal (https://westin-faculty.vercel.app)
ONESIGNAL_APP_ID=88500375-185d-4ea7-b3fc-bf32b8280b3b
ONESIGNAL_REST_API_KEY=<one-signal-rest-api-key from dashboard Keys & IDs>
# ONESIGNAL_API_URL=https://onesignal.com/api/v1

# OneSignal Web Push — student portal (https://westin-student.vercel.app).
# Separate app: browser same-origin policy forbids one app serving two origins.
ONESIGNAL_APP_ID_Students=53e2a6fc-6850-43f0-bb4f-aa60881a49e0
ONESIGNAL_REST_API_KEY_Students=<student-app-rest-api-key>

# Rate limiting (all optional — defaults shown; per-IP budgets are sized for
# a campus behind one NAT IP, see src/modules/ratelimit/rate-limit.guard.ts).
# RATE_LIMIT_OFF=true
# RL_EDGE_IP_PER_MIN=900
# RL_EDGE_IP_BURST_PER_10S=150
# RL_LOGIN_IP_PER_MIN=30
# RL_LOGIN_ID_PER_HOUR=20
# RL_OTP_IP_PER_HOUR=60
# RL_READ_PER_MIN=120
